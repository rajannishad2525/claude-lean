{
  "id": "caching-disabled",
  "title": "Prompt caching is disabled by an environment variable",
  "source": "https://code.claude.com/docs/en/prompt-caching#disable-prompt-caching (DISABLE_PROMPT_CACHING, _HAIKU, _SONNET, _OPUS, _FABLE); https://code.claude.com/docs/en/env-vars",
  "confidence": "official",
  "detect": {
    "metric": "settingState",
    "source": "env",
    "key": "DISABLE_PROMPT_CACHING",
    "prefix": true,
    "when": "present"
  },
  "fix": {
    "type": "settings",
    "text": "Remove DISABLE_PROMPT_CACHING* variables; without caching every request pays full price for the whole context.",
    "edit": {
      "op": "removeEnv"
    }
  }
}
